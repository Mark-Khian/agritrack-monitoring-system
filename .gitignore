# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables - never commit secrets
.env
.env.local
.env.production

# SSL Certificates - NEVER commit private keys to git
server/ssl/
server/backups/*.sql

# Local evaluation seed output. README stays tracked; JSON manifests do not.
server/backups/evaluation-seed-manifests/*.json

# JWT RSA Key Pair - NEVER commit cryptographic keys
server/private.key
server/public.key
