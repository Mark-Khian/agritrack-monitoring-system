# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=5000
HTTPS_PORT=5443
FORCE_HTTPS=false
BIND_HOST=127.0.0.1

# ── CORS / CSRF trusted origins ───────────────
# Exact frontend origins only. Comma-separated. No wildcards, no private-IP ranges.
# CSRF and credentialed CORS share this list.
# Production has no localhost fallback: set ALLOWED_ORIGINS (or legacy ALLOWED_ORIGIN).
#
# Local development example:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.x.x:5173
#
# LAN production example:
# ALLOWED_ORIGINS=http://agritrack.local
#
# Railway/evaluation example:
# ALLOWED_ORIGINS=https://<deployment-domain>
#
# Legacy single-origin fallback if ALLOWED_ORIGINS is unset:
# ALLOWED_ORIGIN=http://localhost:5173

# ── Cookie Session (Phase 3) ──────────────────
# Set true in production (HTTPS only)
COOKIE_SECURE=false

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
# Local manual UI work should use crop_management_dev.
# Automated tests use crop_management_rearch_test and may reset it.
DB_NAME=crop_management_dev

# ── Offline login challenge (Phase 7) ─────────
# Dedicated secret. Do not reuse any leftover JWT_SECRET if one still exists.
# JWT_SECRET is unused for authentication and is not required to start.
# Production must bind Express to 127.0.0.1 behind Nginx.
LOGIN_CHALLENGE_SECRET=generate_a_32+_character_random_secret
# LOGIN_IP_CHALLENGE_THRESHOLD=3
# LOGIN_IP_CHALLENGE_WINDOW_MINUTES=5
# LOGIN_IDENTITY_CHALLENGE_THRESHOLD=5
# LOGIN_IDENTITY_CHALLENGE_WINDOW_MINUTES=15


